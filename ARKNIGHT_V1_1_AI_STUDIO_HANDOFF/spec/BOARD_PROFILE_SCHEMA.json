{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/arknight/v1.1/board-profile.schema.json",
  "title": "Arknight V1.1 BoardProfile",
  "type": "object",
  "required": [
    "profileId",
    "mode",
    "laneCount",
    "lanes"
  ],
  "properties": {
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "mode": {
      "enum": [
        "classic",
        "custom"
      ]
    },
    "laneCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": [
          "laneId",
          "laneOrder",
          "frontSlots",
          "rearSlots"
        ],
        "properties": {
          "laneId": {
            "type": "string",
            "minLength": 1
          },
          "laneOrder": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4
          },
          "frontSlots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          },
          "rearSlots": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
